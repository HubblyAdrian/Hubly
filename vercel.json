{
  "version": 2,
  "routes": [
    {
      "src": "/_compare/(.*)",
      "dest": "/_compare/$1"
    },
    {
      "src": "/api/draft-session$",
      "dest": "/api/draft-session.js"
    },
    {
      "src": "/api/notify$",
      "dest": "/api/notify.js"
    },
    {
      "src": "/api/notify-signup$",
      "dest": "/api/notify-signup.js"
    },
    {
      "src": "/api/notify-readiness$",
      "dest": "/api/notify-readiness.js"
    },
    {
      "src": "/api/support-chat$",
      "dest": "/api/support-chat.js"
    },
    {
      "src": "/api/import-analyze$",
      "dest": "/api/import-analyze.js"
    },
    {
      "src": "/robots.txt$",
      "dest": "/robots.txt"
    },
    {
      "src": "/(.*)",
      "dest": "/api/router.js"
    }
  ]
}
